# Ace3 framework. NOT committed -- fetched into Libs/ by `task libs` (or the
# BigWigs packager at release). Ace3.xml embeds CallbackHandler-1.0, so no
# separate CallbackHandler line is needed. Must load before any build/* module.
Libs\LibStub\LibStub.lua
Libs\Ace3\Ace3.xml
# SFX-Widgets: extra AceGUI widget types (SFX-Header, SFX-Info) used by the
# why-drawer and options panel. Loads after Ace3 (resolves AceGUI-3.0 via
# LibStub). Fetched by `task libs` / the packager; not committed.
Libs\AceGUI-3.0_SFX-Widgets\AceGUI-3.0_SFX-Widgets.xml

# Compiled Lua (Fennel sources live in src/, compiled to build/ by `task build`).
# UI scaffold load order: leaves first (no require resolution in addon scope --
# each module registers itself into _G.Routina, downstream modules read from
# there). See docs/UI.md §2 for the dual-mode pattern.
build\ui\theme.lua
build\ui\format.lua
build\ui\acegui.lua
# Pure domain (no WoW API). Loaded before the tabs that consume them so
# _G.Routina.{schemas,validate,drop-chance,plan} are populated downstream.
# schemas before validate (validate reads the registry at load).
build\domain\schemas.lua
build\domain\validate.lua
# ctx: pure raw-snapshot -> (player, RouteContext) assembler. Needs only
# schemas + validate; the shell (wow + planner) feeds it live client data.
build\domain\ctx.lua
build\domain\lockouts.lua
# weekly-state: pure per-character weekly-progress record. Accumulated by
# src/core/events.fnl across a session and flushed to db.char on logout.
build\domain\weekly-state.lua
build\domain\activities.lua
# BiS catalog: generated per-spec data modules + manifest register into
# _G.Routina.bis-by-spec; bis-catalog.lua loads LAST and flattens them. See
# scripts/import-bis.lua + vendor/bis-source/. Regenerate with `task import-bis`.
build\domain\bis\warrior-arms.lua
build\domain\bis\warrior-fury.lua
build\domain\bis\warrior-protection-mitigation.lua
build\domain\bis\warrior-protection-threat.lua
build\domain\bis\paladin-holy.lua
build\domain\bis\paladin-protection.lua
build\domain\bis\paladin-retribution.lua
build\domain\bis\hunter-beast-mastery.lua
build\domain\bis\hunter-marksmanship.lua
build\domain\bis\hunter-survival.lua
build\domain\bis\rogue-any.lua
build\domain\bis\priest-holy.lua
build\domain\bis\priest-shadow.lua
build\domain\bis\shaman-elemental.lua
build\domain\bis\shaman-enhancement.lua
build\domain\bis\shaman-restoration.lua
build\domain\bis\mage-arcane.lua
build\domain\bis\mage-fire.lua
build\domain\bis\mage-frost.lua
build\domain\bis\warlock-affliction.lua
build\domain\bis\warlock-demonology.lua
build\domain\bis\warlock-destruction.lua
build\domain\bis\druid-balance.lua
build\domain\bis\druid-feral-dps.lua
build\domain\bis\druid-feral-tank-mitigation.lua
build\domain\bis\druid-feral-tank-threat.lua
build\domain\bis\druid-restoration.lua
build\domain\bis\manifest.lua
build\domain\bis-catalog.lua
# Drop table: generated drops\data.lua registers _G.Routina.drop-data;
# drop-table.lua reads + validates it. See scripts/import-drops.lua.
build\domain\drops\data.lua
build\domain\drop-table.lua
build\domain\drop-chance.lua
# history: cumulative observation log feeding bayesian-luck. After drop-chance
# (uses it); accumulated by src/core/events.fnl behind a default-off flag.
build\domain\history.lua
build\domain\plan.lua
# route: the orchestrator -- ties activities + bis-catalog + drop-table +
# drop-chance together and delegates ordering to plan. Loads after all of them.
build\domain\route.lua
# Core boundary/state. wow + saved-vars only need schemas/validate (loaded
# above); events is pure dispatch. ace (the AceAddon entry) loads LAST -- it
# requires root and wires everything via the Ace3 libs loaded at the top.
build\core\wow.lua
# planner: gathers the live client (wow) into ctx.build's snapshot -> route
# input for the Plan tab. Loads after wow + domain/ctx, before the UI tabs.
build\core\planner.lua
build\core\saved-vars.lua
build\core\events.lua
build\ui\widgets\why-drawer.lua
# chance-meter + lockout-timer: the two sanctioned custom CreateFrame widgets
# (AceGUI lacks a proportional fill / a ticking countdown). After core\wow
# (lockout-timer reads server time via wow.now, injected by the lockouts tab)
# and before the tabs that compose them.
build\ui\widgets\chance-meter.lua
build\ui\widgets\lockout-timer.lua
build\ui\tabs\weekly.lua
build\ui\tabs\lockouts.lua
build\ui\tabs\bis.lua
build\ui\root.lua
# options: AceConfig panel (the only AceGUI surface). After root (it refreshes
# the plan on change), before ace (which registers it on init).
build\ui\options.lua
build\core\ace.lua
