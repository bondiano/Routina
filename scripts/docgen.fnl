;;; docgen.fnl - generate docs/api.md from src/domain/* docstrings.
;;; Run via `task docs`. Walks every src/domain/*.fnl, extracts each public
;;; function (M.name) and its docstring, and writes one markdown section per
;;; module. Internal helpers (plain `fn` not on M) are intentionally skipped.

(local out-path :docs/api.md)

(fn slurp [path]
  (with-open [f (assert (io.open path :r))]
    (f:read :*a)))

(fn spit [path content]
  (with-open [f (assert (io.open path :w))]
    (f:write content)))

(fn list-domain-files []
  "Sorted list of src/domain/*.fnl paths."
  (let [files []]
    (with-open [p (assert (io.popen "find src/domain -name '*.fnl' | sort"))]
      (each [line (p:lines)]
        (table.insert files line)))
    files))

(fn module-name [path]
  "src/domain/drop-chance.fnl -> drop-chance"
  (-> path
      (string.match "([^/]+)%.fnl$")))

(fn public-fns [source]
  "Extract [{:name :args :doc}] for every (fn|lambda M.x [..] \"doc\" ...)."
  (let [entries []]
    ;; head = fn|lambda, name = field on M, args = [..], doc = first string.
    (each [head name args doc (string.gmatch source
                                             "%(([%a]+)%s+M%.([^%s%(%[]+)%s*(%b[])%s*\"([^\"]*)\"")]
      (when (or (= head :fn) (= head :lambda))
        (table.insert entries {: name : args : doc})))
    entries))

(fn render-doc [doc]
  "Indent a multi-line docstring as a markdown blockquote."
  (let [lines []]
    (each [line (string.gmatch (.. doc "\n") "(.-)\n")]
      (table.insert lines (.. "> " (line:gsub "^%s+" ""))))
    (table.concat lines "\n")))

(fn render-module [path]
  (let [name (module-name path)
        fns (public-fns (slurp path))
        parts [(.. "## " name) (.. "`" path "`") ""]]
    (if (= 0 (length fns))
        (table.insert parts "_No documented public functions._")
        (each [_ {: name : args : doc} (ipairs fns)]
          (table.insert parts (.. "### `M." name " " args "`"))
          (table.insert parts "")
          (table.insert parts (render-doc doc))
          (table.insert parts "")))
    (values (table.concat parts "\n") (length fns))))

(let [files (list-domain-files)
      header ["# Routina domain API"
              ""
              "_Generated by `task docs` (scripts/docgen.fnl). Do not edit by hand._"
              ""]
      sections []]
  (var fn-count 0)
  (each [_ path (ipairs files)]
    (let [(section n) (render-module path)]
      (set fn-count (+ fn-count n))
      (table.insert sections section)))
  (spit out-path (.. (table.concat header "\n") (table.concat sections "\n")
                     "\n"))
  (print (string.format "docgen: %d module(s), %d public fn(s) -> %s"
                        (length files) fn-count out-path)))
