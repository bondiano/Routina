;; schemas.fnl -- declarative domain type definitions (single source of truth).
;;
;; PURE data module. No WoW API, no functions, no I/O -- just the shapes that
;; every other layer agrees on. One schema serves three masters:
;;   - src/domain/validate.fnl   -> runtime validation at module boundaries
;;   - /docgen                    -> docs/api.md type tables
;;   - spec/helpers/gen.fnl       -> test-fixture generators
;;
;; Field-type DSL (see .claude/examples/07-type-contracts.fnl PART 3):
;;   :string :number :integer :boolean   -- scalars (keywords are :string)
;;   {:field <ftype> ...}                 -- inline record schema
;;   [:enum :a :b :c]                     -- one of these literal keywords
;;   [:list <ftype>]                      -- sequence of items matching ftype
;;   [:map <key-ftype> <val-ftype>]       -- table with typed keys and values
;;   [:ref :OtherSchema]                  -- reference to a schema in this table
;;   [:optional <ftype>]                  -- field may be nil
;;
;; Keep this file pure data: validation logic lives in validate.fnl so the
;; schemas stay reflectable (iterate fields, derive docs, build fixtures).

(local M {})

;; Reputation ladder, low -> high (full TBC standing set). Held as a plain
;; local, not a registered schema: a bare [:enum ...] vector is not a record,
;; and schemas_spec asserts every entry in M is a non-empty record. Inlined
;; into Player.reputations and RepRequirement.standing below.
(local standing-enum [:enum
                      :hated
                      :hostile
                      :unfriendly
                      :neutral
                      :friendly
                      :honored
                      :revered
                      :exalted])

;; --- Leaf shapes -----------------------------------------------------------

(set M.Item {:id :integer :name :string})

(set M.Encounter {:name :string :killed? :boolean})

;; --- Lockouts (fed by src/core/events.fnl in Phase 2) ----------------------

;; Two lockout shapes, on purpose:
;;   Lockout      -- the RAW record as WoW's RequestRaidInfo reports it. The
;;                   imperative shell (src/core/events.fnl) receives this.
;;   LockoutView  -- the PLANNER-facing projection src/domain/lockouts.fnl
;;                   operates on. The shell maps raw -> view on ingest and
;;                   validates the result with `(validate.assert! LockoutView v)`.
;; :id is normalised to a string key at the boundary (owner+instance), so a
;; lockout is addressable regardless of whether WoW gave a numeric instance id.

(set M.Lockout {:name :string
                :instance-id :integer
                :reset-at :integer
                :difficulty [:enum :normal :heroic]
                :is-raid? :boolean
                :encounters [:list [:ref :Encounter]]})

(set M.LockoutView {:id :string
                    :expiry :integer
                    :bosses-killed :integer
                    :bosses-total :integer
                    :owner :string})

;; --- Weekly-state (persisted per character; src/domain/weekly-state.fnl) ----
;;
;; The in-memory record the imperative shell (src/core/events.fnl) accumulates
;; across a session -- which saved raids were entered this week -- and flushes to
;; addon.db.char.weekly-state on logout. :reset-at 0 means "reset unknown" (kept
;; until a real reset is learned); :reset-time on the parent is derived from the
;; entries by weekly-state.fnl, never stored independently.

(set M.WeeklyLockout {:in-progress? :boolean
                      :entered-at :integer
                      :reset-at :integer})

(set M.WeeklyState
     {:reset-time :integer :lockouts [:map :string [:ref :WeeklyLockout]]})

;; --- History (cumulative; persisted per character; src/domain/history.fnl) --
;;
;; Lifetime observation counts feeding drop-chance.bayesian-luck: how often each
;; activity ran and each item dropped. Keys are stringified ids (SavedVariables-
;; safe). Distinct from WeeklyState (which resets weekly) -- history never prunes.

(set M.History {:runs [:map :string :integer] :drops [:map :string :integer]})

;; --- Chains (quest/attunement chains; src/domain/chains.fnl) ----------------
;;
;; ChainDef is STATIC registry data (generated by scripts/import-chains.lua
;; from the vendored Attune dataset, or player-authored for :custom). A chain
;; is a list of steps with prerequisite links; TBC attunement chains are
;; near-linear, so prerequisites are a flat :follows list of step ids plus a
;; :follows-mode -- :all (Attune's `&`) or :any (`|`) -- never an expression
;; tree. :quest-id is present on quest-flagged steps (:quest/:pickup/:turnin)
;; and drives seeding from IsQuestFlaggedCompleted; other step kinds are
;; inferred by backfill (see chains.seed-from-completed). :coord enters the
;; shape now but stays nil until Phase 9 supplies waypoint data (Attune data
;; carries no coordinates). :stage is the source's display ordering.
;;
;; ChainProgress is the PERSISTED per-character record: just the set of
;; completed step ids. "Current step" and "fraction done" are derived by
;; src/domain/chains.fnl, never stored.

(set M.ChainStep
     {:id :string
      :type [:enum
             :quest
             :kill
             :item
             :pickup
             :turnin
             :level
             :rep
             :interact
             :click
             :attune
             :end]
      :label :string
      :quest-id [:optional :integer]
      :stage [:optional :integer]
      :follows [:list :string]
      :follows-mode [:enum :all :any]
      :coord [:optional {:map-id :integer :x :number :y :number}]})

(set M.ChainDef {:id :string
                 :name :string
                 :kind [:enum :attunement :quest-line :daily-circuit :custom]
                 :expac :string
                 :faction [:optional :string]
                 :steps [:list [:ref :ChainStep]]})

(set M.ChainProgress {:completed [:map :string :boolean]})

;; --- Planner inputs (consumed by src/domain/plan.fnl) ----------------------
;;
;; TargetItem mirrors the per-item shape plan.fnl scores; :item-id is carried
;; through verbatim so the UI can drive GameTooltip:SetItemByID.

(set M.TargetItem {:label :string
                   :p :number
                   :runs :integer
                   :item-id [:optional :integer]})

(set M.Activity {:id :string
                 :name :string
                 :type :string
                 :detail :string
                 :minutes :number
                 :items [:list [:ref :TargetItem]]})

;; --- Player (consumed by activities/route requirement checks) --------------
;;
;; The character state a requirement check reads. :attunements is a set
;; ({:kara-key true}); :reputations maps a faction key to a standing.

(set M.Player {:level :integer
               :attunements [:map :string :boolean]
               :reputations [:map :string standing-enum]})

;; --- Activity registry (consumed by src/domain/activities.fnl) -------------
;;
;; ActivityDef is the STATIC content registry: what weekly content exists, its
;; reset cadence, and prerequisites. :group-size is the instance party/raid cap
;; (10/25/40 raids, 5 dungeons) used to scale loot competition; unset for
;; non-instanced content (vendor/quest/daily/rep-hub), which is uncontested.
;; Distinct from the scored, plan-facing
;; `Activity` above (which plan.fnl renders); the two share ids (:karazhan ...)
;; so a scored row can be traced back to its definition. Reputation hubs are
;; modelled as activities (PRD OQ-4 resolved): :rep-hub is a live type and
;; :requirements carries an optional :rep gate.

(set M.ActivityDef
     {:id :string
      :name :string
      :type [:enum
             :raid
             :heroic
             :daily
             :weekly-quest
             :rep-hub
             :vendor
             :world-boss
             :dungeon]
      :reset [:enum :weekly :daily :none]
      :length-estimate :integer
      :group-size [:optional :integer]
      :requirements [:ref :ActivityRequirements]})

(set M.ActivityRequirements
     {:min-level :integer
      :attunement [:optional :string]
      :rep [:optional [:ref :RepRequirement]]})

(set M.RepRequirement {:faction :string :standing standing-enum})

;; --- BiS catalog -----------------------------------------------------------

(set M.BisItem {:class [:enum
                        :warrior
                        :paladin
                        :priest
                        :mage
                        :warlock
                        :druid
                        :rogue
                        :hunter
                        :shaman]
                :spec :string
                :phase :integer
                ;; :kind -- provenance class of the recommendation, orthogonal to
                ;; :phase. :bis = endgame raid/world-boss/tier-token target;
                ;; :pre-raid = catch-up gear worn TOWARD that BiS (dungeon,
                ;; heroic, crafted, reputation, quest, vendor, PvP, BoE).
                :kind [:enum :pre-raid :bis]
                ;; :rank -- within (class spec phase kind slot), 1 = best. Maps
                ;; to the source's Priority (lower = better); not contiguous when
                ;; a slot mixes kinds, but always monotone within one.
                :rank :integer
                :slot [:enum
                       :head
                       :neck
                       :shoulder
                       :back
                       :chest
                       :wrist
                       :hands
                       :waist
                       :legs
                       :feet
                       :ring1
                       :ring2
                       :trinket1
                       :trinket2
                       :main-hand
                       :off-hand
                       :ranged]
                :item [:ref :Item]
                :sources [:list
                          {:instance :string
                           :boss [:optional :string]
                           :drop-rate [:optional :number]}]})

;; --- Drop table (consumed by src/domain/drop-table.fnl) --------------------
;;
;; DropEntry is one row of the item-id -> drop map (generated by
;; scripts/import-drops.lua from the nexus-devs dataset). :source-activity is a
;; keyword (instance slug like :karazhan, or :vendor / :quest / :unknown).
;; :base-drop-p is the raw chance (1.0 for guaranteed vendor/quest items).
;; :ml-pool (master-loot competition pool) is unset in v1 -- Phase 4 / OQ-3.

(set M.DropEntry {:item-id :integer
                  :source-activity :string
                  :base-drop-p :number
                  :boss [:optional :string]
                  :zone [:optional :string]
                  :ml-pool [:optional :integer]})

;; --- Route context (consumed by src/domain/route.fnl) ----------------------
;;
;; The pure inputs route.plan-week needs beyond the schemas.Player it scores
;; against. Assembled by the imperative shell (src/core/events.fnl + wow.fnl):
;; :class/:spec/:phase identify the BiS list, :now is GetServerTime() seconds,
;; :owned-items is the set of item-ids already acquired (a gap is "unowned"),
;; :lockouts maps an ActivityDef :id to its planner-facing LockoutView, and the
;; optional :weights (slot -> 1..5) / :competitors (activity-id -> >=1) carry the
;; player's options (defaults: weight 1, competitors 1). :composition is the
;; player's usual raid makeup (role -> headcount, roles per
;; src/domain/competition.fnl); when set, route derives per-item competitors
;; from it instead of :default-competitors. :seed is the optional
;; user-controlled Monte Carlo seed for route.project-week (default applied
;; downstream). Validated once at the route boundary, never in the scoring loop.

(set M.RouteContext
     {:class :string
      :spec :string
      :phase :integer
      :now :integer
      :owned-items [:map :integer :boolean]
      :lockouts [:map :string [:ref :LockoutView]]
      :weights [:optional [:map :string :number]]
      :competitors [:optional [:map :string :number]]
      :composition [:optional [:map :string :number]]
      :default-competitors [:optional :number]
      :seed [:optional :integer]
      :include-classic? [:optional :boolean]})

;; --- Register into the addon namespace -------------------------------------
;;
;; Dual-mode: in-game, the .toc load order populates `_G.Routina.schemas`
;; before validate.fnl and the domain modules that read it. In tests,
;; consumers fall through to `(require :src.domain.schemas)` -> the same M.

(local Routina (or _G.Routina {}))
(set _G.Routina Routina)
(set Routina.schemas M)

M
