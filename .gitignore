# go-task checksum cache
.task/

# Compiled Lua output (regenerate with `task build`)
build/

# project-local luajit rocks tree (busted/luacov); recreate with `task deps`
.rocks/

# busted/luacov coverage artifacts
luacov.stats.out
luacov.report.out

# BigWigs packager output
.release/

# Ace3 framework externals (fetched by `task libs`; never committed -- see
# .pkgmeta). Keep the directory itself via .gitkeep so .toc lib paths resolve.
Libs/*
!Libs/.gitkeep
